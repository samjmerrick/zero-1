---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page doesn’t exist.">
  <section class="wrap" style="padding-block: 120px; text-align: center">
    <div class="stack" style="--gap: 24px; align-items: center">
      <p class="mono outline-text" aria-hidden="true" style="font-size: clamp(96px, 16vw, 200px); line-height: 0.9; -webkit-text-stroke-width: 2.5px">404</p>
      <h1 class="h2">This page is still a 0.</h1>
      <p class="muted">It doesn’t exist, or it hasn’t been built yet.</p>
      <a href="/" class="btn btn-signal">Back to the home page</a>
    </div>
  </section>
</Base>
