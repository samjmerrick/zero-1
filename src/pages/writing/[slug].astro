---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/writing';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} type="article" noindex={entry.data.draft}>
  <article class="wrap" style="padding-block: 88px var(--section)">
    <div class="stack" style="--gap: 20px; max-width: 68ch">
      <a href="/writing" class="small">← All writing</a>
      {entry.data.draft && <p class="chip chip-solid">Draft: not published</p>}
      <p class="label">{entry.data.topic} · <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
      <h1 class="h1" style="font-size: clamp(38px, 5vw, 64px)">{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <div class="prose essay"><Content /></div>
      <div class="card stack" style="--gap: 12px; margin-top: 24px">
        <p class="label">Got an idea at 0?</p>
        <p>Run it through the free Pressure-Tester, or tell me about it.</p>
        <div class="row"><a href="/ventures/pressure-test" class="btn btn-signal">Pressure-test it</a><a href="/start" class="btn btn-outline">Start a project</a></div>
      </div>
    </div>
  </article>
</Base>
<style>
  .essay :global(p), .essay :global(li) { color: var(--ink); font-size: 19px; line-height: 1.65; }
  .essay :global(h2) { margin-top: 48px; }
  .essay :global(ol), .essay :global(ul) { padding-left: 1.2em; }
  .essay :global(blockquote) { margin: 24px 0; padding-left: 20px; border-left: 3px solid var(--signal); }
</style>
