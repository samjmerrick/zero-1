---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getPosts, formatDate } from '../../lib/writing';

const posts = await getPosts();
---
<Base title="Writing" description="Essays on finding the business worth building: ideation, unit economics, AI and field notes." noindex={posts.length === 0}>
  <section class="wrap" style="padding-block: 88px var(--section)">
    <div class="stack" style="--gap: 48px">
      <SectionHead as="h1" index="111" label="Writing" title="Notes from 0 to 1.">
        <p class="lede">What I’m learning about turning ideas into businesses, including the ones that didn’t make it.</p>
      </SectionHead>
      {posts.length === 0 ? (
        <p class="muted">The first essays are on their way.</p>
      ) : (
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.id}`} class="post">
                <span class="label">{p.data.topic} · <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>{p.data.draft && ' · DRAFT'}</span>
                <span class="h3 title">{p.data.title}</span>
                <span class="muted small">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</Base>
<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .post { display: flex; flex-direction: column; gap: 8px; padding: 28px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .title { font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.03em; }
</style>
