---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';

const roles = [
  { years: '2023 – now', role: 'Senior Product Manager', org: 'Simprints', note: 'Leading ML engineers on biometrics for global health, running offline on low-cost phones.' },
  { years: '2022 – 2023', role: 'Senior Product Manager', org: 'Sixteenth', note: 'First in-house technical hire. Led Spark Jam, an LLM-powered content ideation tool.' },
  { years: '2021 – 2022', role: 'Product Manager', org: 'Student Beans', note: 'Led the growth tribe. Website rebuild lifted conversion by around 50%.' },
  { years: '2018 – 2021', role: 'Product Manager', org: 'Virgin Red', note: 'Founding team. Introduced ML reward targeting, linked to a 30% rise in engagement.' },
];
const credentials = [
  'BSc Sound and Video Technology (First Class), University of Salford',
  'Google Cloud Fundamentals: Big Data & Machine Learning',
  'Product Leadership, Roman Pichler',
  'Growth Series, Reforge',
  'Good Clinical Practice, NIHR',
];
---
<Base title="About" description="Sam Merrick leads machine learning teams building computer vision for global health, and runs Zero-1 Studio.">
  <section class="wrap about">
    <div class="portrait" role="img" aria-label="Portrait of Sam Merrick (to be added)"><span class="label">Portrait to come</span></div>
    <div class="stack" style="--gap: 24px; flex: 999 1 480px; min-width: 0">
      <SectionHead as="h1" index="011" label="About" title="Hi, I’m Sam." />
      <div class="prose stack">
        <p>I’ve spent eight years building products, and the last few leading machine learning teams. At Simprints I lead a team building biometric recognition for global health. It runs fully offline on low-cost Android phones, so health workers can be sure who they’re treating. We took infant recognition from around 40% to around 90% accuracy, open-sourced our face recognition library, and published privacy research with the International Committee of the Red Cross.</p>
        <p>Before that I was first technical hire at Sixteenth, where I built Spark Jam, an LLM-powered ideation tool for creators. I led growth at Student Beans and was on the founding team of Virgin Red.</p>
        <p>The lesson that runs through all of it: a model is only as good as the product around it. Zero-1 is my studio for helping founders and teams get both right, and for launching a few products of my own.</p>
      </div>
      <div class="row"><a href="/start" class="btn btn-signal">Start a project</a><a href="https://samjmerrick.com" class="btn btn-outline">samjmerrick.com →</a></div>
    </div>
  </section>

  <section class="wrap section rule-top stack" style="--gap: 32px">
    <SectionHead index="100" label="Experience" title="Where the 1s came from." />
    <ol class="roles">
      {roles.map((r) => (
        <li class="role">
          <span class="label">{r.years}</span>
          <div class="stack" style="--gap: 4px">
            <h3 class="h3" style="font-size: 20px">{r.role} · {r.org}</h3>
            <p class="small muted">{r.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap" style="padding-bottom: var(--section)">
    <div class="card stack">
      <p class="label">Research and open source</p>
      <ul class="list-plain small">
        <li><a href="https://arxiv.org/abs/2508.18415">Securing Face and Fingerprint Templates in Humanitarian Biometric Systems</a> (arXiv, 2025), with the ICRC</li>
        <li><a href="https://github.com/Simprints/Biometrics-SimFace">SimFace</a>: open-source face detection, quality and matching for low-cost Android devices</li>
        <li><a href="https://github.com/Simprints/Biometrics-SimPolyProtect">SimPolyProtect</a>: biometric template protection</li>
      </ul>
      <p class="label" style="margin-top: 16px">Credentials</p>
      <ul class="list-plain small muted">{credentials.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .about { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; padding-block: 88px var(--section); }
  .portrait { flex: 1 1 320px; max-width: 420px; aspect-ratio: 4 / 5; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; }
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .role { display: grid; grid-template-columns: minmax(120px, 180px) 1fr; gap: 16px 32px; padding: 24px 0; border-bottom: 1px solid var(--rule); }
  @media (max-width: 560px) { .role { grid-template-columns: 1fr; } }
</style>
