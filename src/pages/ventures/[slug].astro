---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StateBits from '../../components/StateBits.astro';

export async function getStaticPaths() {
  const ventures = await getCollection('ventures', (v) => v.data.public);
  return ventures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const level = { exploring: 1, validating: 2, building: 3, live: 4 }[entry.data.stage];
---
<Base title={entry.data.name} description={entry.data.summary}>
  <article class="wrap" style="padding-block: 88px var(--section)">
    <div class="stack" style="--gap: 20px; max-width: 64ch">
      <a href="/ventures" class="small">← All ventures</a>
      <span class="row" style="--gap: 10px"><StateBits n={level} label={`Stage: ${entry.data.stage}`} /><span class="label" style="color: inherit">{entry.data.stage}</span></span>
      <h1 class="h1" style="font-size: clamp(40px, 5.5vw, 68px)">{entry.data.name}</h1>
      <p class="lede">{entry.data.summary}</p>
      <div class="prose"><Content /></div>
      {entry.data.link && <div class="row"><a href={entry.data.link} class="btn btn-signal">Try it</a></div>}
    </div>
  </article>
</Base>
