---
import { Image } from 'astro:assets';
import sam from '../assets/sam-merrick.webp';

interface Props { eager?: boolean }
const { eager = false } = Astro.props;
---
<figure class="portrait">
  <Image src={sam} alt="Sam Merrick, smiling, outdoors in front of autumn trees" widths={[400, 640, 800]} sizes="(max-width: 700px) 100vw, 440px" loading={eager ? 'eager' : 'lazy'} />
</figure>
<style>
  .portrait { flex: 1 1 300px; max-width: 440px; margin: 0; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--rule); background: var(--surface); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
