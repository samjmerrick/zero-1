---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getPosts } from '../lib/writing';

const hasWriting = (await getPosts()).length > 0;
const nav = [
  { href: '/approach', text: 'Approach' },
  { href: '/services', text: 'Services' },
  { href: '/work', text: 'Work' },
  { href: '/ventures', text: 'Ventures' },
  ...(hasWriting ? [{ href: '/writing', text: 'Writing' }] : []),
  { href: '/about', text: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header class="header">
  <nav aria-label="Main" class="wrap bar">
    <a href="/" class="home" aria-label="Zero-1 Studio home"><Mark /><Wordmark /></a>
    <div class="links wide">
      {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.text}</a>)}
    </div>
    <div class="actions">
      <ThemeToggle />
      <a href="/start" class="btn btn-ink cta">Start a project</a>
      <details class="menu">
        <summary class="mono" aria-label="Menu">Menu</summary>
        <div class="menu-panel">
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.text}</a>)}
          <a href="/start" class="btn btn-signal menu-cta">Start a project</a>
        </div>
      </details>
    </div>
  </nav>
</header>
<style>
  .header { border-bottom: 1px solid var(--rule); position: relative; }
  .bar { display: flex; align-items: center; gap: 16px 28px; padding-block: 16px; }
  .home { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .links { display: flex; gap: 8px 24px; align-items: center; font-size: 15px; }
  .links a, .menu-panel a { text-decoration: none; }
  a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 8px; }
  .actions { display: flex; align-items: center; gap: 10px; }
  .cta { min-height: 44px; padding: 10px 18px; font-size: 15px; }
  .menu { display: none; }
  summary { list-style: none; cursor: pointer; min-height: 44px; display: flex; align-items: center; padding: 0 16px; border: 1px solid var(--rule); border-radius: 999px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; }
  summary::-webkit-details-marker { display: none; }
  .menu[open] summary { border-color: var(--ink); }
  .menu-panel { position: absolute; left: 0; right: 0; top: 100%; z-index: 20; background: var(--paper); border-bottom: 1px solid var(--rule); padding: 8px var(--gutter) 20px; display: flex; flex-direction: column; }
  .menu-panel .menu-cta { margin-top: 20px; border: 0; font-size: 17px; padding: 12px 24px; }
  .menu-panel a:not(.btn) { padding: 14px 0; font-size: 20px; font-weight: 600; letter-spacing: -0.02em; border-bottom: 1px solid var(--rule); }
  @media (max-width: 900px) {
    .wide { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 420px) {
    .cta { display: none; }
  }
</style>
