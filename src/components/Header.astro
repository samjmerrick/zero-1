---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/approach', text: 'Approach' },
  { href: '/services', text: 'Services' },
  { href: '/work', text: 'Work' },
  { href: '/ventures', text: 'Ventures' },
  { href: '/about', text: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="header">
  <nav aria-label="Main" class="wrap bar">
    <a href="/" class="home" aria-label="Zero-1 Studio home"><Mark /><Wordmark /></a>
    <div class="links">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.text}</a>
      ))}
      <ThemeToggle />
      <a href="/start" class="btn btn-ink cta">Start a project</a>
    </div>
  </nav>
</header>
<style>
  .header { border-bottom: 1px solid var(--rule); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; padding-block: 16px; }
  .home { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: flex-end; flex: 1 1 auto; font-size: 15px; }
  .links > a:not(.btn) { text-decoration: none; }
  .links > a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 8px; }
  .cta { min-height: 44px; padding: 10px 18px; font-size: 15px; }
</style>
