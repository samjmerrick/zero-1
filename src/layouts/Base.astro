---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Keep a page out of search results (e.g. the thank-you page). */
  noindex?: boolean;
  /** 'article' for essays; everything else is a website page. */
  type?: 'website' | 'article';
}
const { title, description, noindex = false, type = 'website' } = Astro.props;
const ogImage = new URL('/og.png', Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${Astro.site}#org`, name: 'Zero-1 Studio', url: Astro.site?.toString(), logo: new URL('/favicon.svg', Astro.site).toString(), founder: { '@id': `${Astro.site}#sam` } },
    { '@type': 'Person', '@id': `${Astro.site}#sam`, name: 'Sam Merrick', url: 'https://samjmerrick.com', jobTitle: 'Founder, Zero-1 Studio', sameAs: ['https://samjmerrick.com', 'https://github.com/samjmerrick'] },
  ],
};
const fullTitle = title === 'Home' ? 'Zero-1 Studio · Find the business worth building' : `${title} · Zero-1 Studio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:locale" content="en_GB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      // Set the theme before paint: saved choice, else the system setting.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Fill state bits in sequence when they scroll into view (skipped for reduced motion).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
        }, { threshold: 0.6 });
        document.querySelectorAll('.bits').forEach((el) => { el.classList.add('will-fill'); io.observe(el); });
      }
    </script>
  </body>
</html>
