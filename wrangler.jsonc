{
  // Cloudflare Worker config. The Astro adapter fills in `main` and `assets`.
  "name": "zero-1",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zero-1",
      "database_id": "1880323d-35a7-406c-b3a9-fb103ea1aba2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Where new enquiry notifications go (requires RESEND_API_KEY secret).
    "NOTIFY_EMAIL": ""
  }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   TURNSTILE_SECRET_KEY  - optional, enables bot check on /start
  //   RESEND_API_KEY        - optional, emails Sam on each new enquiry
}
